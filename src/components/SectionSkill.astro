---
const skills = [
  {
    title: "Frontend Architecture",
    description:
      "Crafting pixel-perfect, responsive interfaces with clean, semantic code. I specialize in HTML5, modern CSS, and JavaScript to ensure high performance and accessibility across all devices.",
  },
  {
    title: "Python & Automation",
    description:
      "Leveraging Python for powerful backend solutions and data processing. My focus includes web scraping, workflow automation, and data analysis using libraries like Pandas to turn raw data into insights.",
  },
  {
    title: "Astro Development",
    description:
      "Creating secure and fast websites with Astro. I focus on pre-rendering content to ensure instant page loads and seamless performance, avoiding the complexity of heavy client-side frameworks.",
  },
];
---

<section class="skills">
  <h2 class="skills-label" id="skills-heading">Technical Specialties</h2>

  <div class="skills-list">
    {
      skills.map((skill) => (
        <article class="skill-card">
          <h3 class="skill-title">{skill.title}</h3>
          <p class="skill-text">{skill.description}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  /* --- Carpeta que envuelve todas las skills --- */
  .skills {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    padding: 1.1rem;
    background: var(--color-bgsecondary);
    border-radius: 18px;
  }

  /* Pestaña de la carpeta: al lado derecho, separada del borde (no al ras) */
  .skills-label {
    position: absolute;
    bottom: 100%;
    margin: 0;
    padding: 0.8rem 0.9rem;
    font-family: var(--font-title);
    font-size: var(--fs-eyebrow);
    font-weight: 650;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-primary);
    background: var(--color-bgsecondary);
    border-radius: 12px 12px 0 0;
  }

  /* Esquinas internas redondas donde la pestaña se une al cuerpo de la carpeta */
  .skills-label::before,
  .skills-label::after {
    content: "";
    position: absolute;
    bottom: 0;
    width: 10px;
    height: 10px;
  }

  .skills-label::before {
    right: 100%;
    background: radial-gradient(
      circle 10px at 0 0,
      transparent 9.5px,
      var(--color-bgsecondary) 10px
    );
  }

  .skills-label::after {
    left: 100%;
    background: radial-gradient(
      circle 10px at 100% 0,
      transparent 9.5px,
      var(--color-bgsecondary) 10px
    );
  }

  /* --- Lista vertical: cada skill debajo de la anterior --- */
  .skills-list {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  /* --- Cada skill con su propio fondo, redondeado (borde interno) --- */
  .skill-card {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.05rem 1.2rem;
    background: var(--color-bg);
    border: 1px solid color-mix(in srgb, var(--color-text) 8%, transparent);
    border-radius: 14px;
  }

  .skill-title {
    font-family: var(--font-title);
    color: var(--color-text);
    font-size: var(--fs-h4);
    font-weight: 650;
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    margin: 0;
  }

  .skill-text {
    font-family: var(--font-text);
    color: var(--color-text);
    font-size: var(--fs-base);
    line-height: 1.6;
    opacity: 0.75;
    margin: 0;
  }

  @media (width < 600px) {
    .skills {
      padding: 0.8rem;
      border-radius: 14px;
    }

    .skills-label {
      right: 1rem;
      padding: 0.3rem 0.9rem;
    }

    .skill-card {
      padding: 0.9rem 1rem;
    }
  }
</style>
