---
interface PostFrontmatter {
  title: string;
  description: string;
  author: string;
  publishDate: string;
  readingTime: string;
  sizeLayout?: "wide" | "tall" | "featured";
  titleCategory?: string;
  image?: {
    url: string;
    alt: string;
  };
}

interface Props {
  post: {
    frontmatter: PostFrontmatter;
    url: string;
  };
}

const { post } = Astro.props;
const { frontmatter, url } = post;
const {
  title,
  description,
  author,
  readingTime,
  titleCategory,
  image,
} = frontmatter;

const sizeClass = frontmatter.sizeLayout
  ? `blog-card--${frontmatter.sizeLayout}`
  : "";

const hasImage = image?.url;
const hasBackgroundImage = hasImage && (frontmatter.sizeLayout === "featured" || frontmatter.sizeLayout === "wide");

const pad = (n: number) => String(n).padStart(2, "0");
const formatDate = (iso: string) => {
  const d = new Date(iso);
  if (isNaN(d.getTime())) return iso;
  return `${pad(d.getDate())}·${pad(d.getMonth() + 1)}·${String(d.getFullYear()).slice(-2)}`;
};
const dateLabel = formatDate(frontmatter.publishDate);
const ariaLabel = `Leer: ${title} — por ${author}`;
---

<article class={`blog-card ${sizeClass} ${hasBackgroundImage ? "has-bg-image" : ""}`}>
  <a href={url} aria-label={ariaLabel} class="blog-card__link">
    {hasBackgroundImage && image && (
      <div class="card-bg-image" style={`background-image: url(${image.url})`} aria-hidden="true"></div>
    )}
    <div class="card-content">
      {!hasBackgroundImage && hasImage && image && (
        <div class="card-image">
          <img src={image.url} alt={image.alt || ""} loading="lazy" />
        </div>
      )}
      <div class="card-meta">
        {titleCategory && (
          <span class="tag--color">{titleCategory}</span>
        )}
        <span class="reading-time">
          <time datetime={`PT${readingTime}M`}>
            {readingTime} min read
          </time>
        </span>
      </div>
      <div class="text-container">
        <h2 class="card-title">{title}</h2>
        <p class="card-text">{description}</p>
      </div>
      <footer class="card-footer">
        <span class="card-date">
          <time datetime={frontmatter.publishDate}>{dateLabel}</time>
        </span>
        <span class="card-author">{author}</span>
      </footer>
    </div>
  </a>
</article>

<style>
  :root {
    --shadow-card:
      0 6px 18px rgba(2, 6, 23, 0.08), 0 2px 6px rgba(2, 6, 23, 0.04);
    --shadow-card-hover:
      0 18px 36px rgba(2, 6, 23, 0.12), 0 8px 16px rgba(2, 6, 23, 0.06);
  }

  .blog-card {
    background: var(--color-bg);
    border-radius: 1.5rem;
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition:
      box-shadow 0.3s ease,
      transform 0.3s ease,
      background 0.3s ease;
    height: auto;
    grid-column: span 2;
  }

  .blog-card--wide {
    grid-column: span 4;
  }

  .blog-card--tall {
    grid-row: span 2;
  }

  .blog-card--featured {
    grid-column: span 2;
    grid-row: span 2;
    background: color-mix(in srgb, var(--color-bgsecondary) 50%, var(--color-bg));
  }

  .blog-card__link {
    text-decoration: none;
    color: var(--color-text);
    display: block;
    cursor: pointer;
    height: 100%;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1;
    gap: 0.2rem;
    height: 100%;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.8rem;
    padding: 1.25rem 1.25rem 0.5rem 1.25rem;
  }

  .tag--color {
    display: inline-flex;
    align-items: center;
    background: color-mix(in srgb, var(--color-primary) 98%, transparent);
    color: var(--color-bg);
    padding: 0.25rem 0.75rem;
    border-radius: 0.5rem;
    font-family: var(--font-title);
    font-size: var(--fs-eyebrow);
    text-transform: uppercase;
    gap: 0.5rem;
    font-weight: 500;
  }

  .reading-time {
    display: inline-flex;
    align-items: center;
    font-size: var(--fs-sm);
    font-weight: 600;
    font-family: var(--font-text);
    opacity: 0.7;
    background-color: rgb(12 10 9 / 0.08);
    border: 1px rgba(117, 114, 114, 0.828) solid;
    padding: 0.25rem 0.675rem;
    border-radius: 0.375rem;
  }

  .text-container {
    display: flex;
    flex-direction: column;
    text-align: left;
    gap: 0.6rem;
    padding: 1rem 1.25rem
  }

  .card-title {
    font-family: var(--font-title);
    font-size: var(--fs-h2);
    font-weight: 400;
    line-height: var(--leading-snug);
    color: var(--color-text);
    margin: 0;
    transition: color 0.3s ease;
  }

  .blog-card:hover .card-title {
    color: var(--color-primary);
  }

  .card-text {
    font-family: var(--font-text);
    font-size: var(--fs-lg);
    line-height: 1.55;
    opacity: 0.75;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-card--tall .card-text,
  .blog-card--featured .card-text {
    -webkit-line-clamp: unset;
    line-clamp: unset;
    display: block;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 1.25rem 1.25rem 1.25rem;
  }

  .card-date {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-title);
    font-size: var(--fs-eyebrow);
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-primary);
    line-height: 1;
  }

  .card-author {
    font-family: var(--font-style);
    font-size: var(--fs-lg);
    color: var(--color-text);
    line-height: 1;
  }

  .blog-card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-6px);
    background: color-mix(in srgb, var(--color-bgsecondary) 20%, var(--color-bg));
  }

  .blog-card__link:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 4px;
  }

  @media (max-width: 800px) {
    .blog-card,
    .blog-card--wide,
    .blog-card--tall,
    .blog-card--featured {
      grid-column: span 1;
      grid-row: span 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-card {
      transition: none;
    }
    .blog-card:hover {
      transform: none;
    }
  }

  .card-image {
    width: 100%;
    height: 12rem;
    overflow: hidden;
    border-radius: 1.5rem 1.5rem 0 0;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .blog-card:hover .card-image img {
    transform: scale(1.05);
  }

  .blog-card--tall .card-image {
    height: 16rem;
  }

  .has-bg-image {
    position: relative;
    background: transparent;
  }

  .has-bg-image .card-bg-image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    border-radius: 1.5rem;
    z-index: 0;
    opacity: 0.15;
    transition: opacity 0.4s ease;
  }

  .has-bg-image:hover .card-bg-image {
    opacity: 0.25;
  }

  .has-bg-image .card-content {
    position: relative;
    z-index: 1;
  }

  .has-bg-image .card-title,
  .has-bg-image .card-text,
  .has-bg-image .card-author,
  .has-bg-image .card-date {
    color: var(--color-text);
  }

  .has-bg-image .tag--color {
    background: color-mix(in srgb, var(--color-primary) 90%, transparent);
  }

  .has-bg-image .blog-card__link:focus-visible {
    outline-color: var(--color-primary);
  }
</style>