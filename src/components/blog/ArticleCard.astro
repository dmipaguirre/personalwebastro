---
import { formatPostDate, padIndex } from "../../data/blogPosts";
import type { PostEntry } from "../../data/blogPosts";

interface Props {
  post: PostEntry;
  index?: number;
}

const { post, index = 1 } = Astro.props;
const { frontmatter, url } = post;
const { title, author, titleCategory } = frontmatter;

const dateLabel = formatPostDate(frontmatter.publishDate);
const ariaLabel = `Leer: ${title} — por ${author}`;
---

<a class="article-row" href={url} aria-label={ariaLabel}>
  <span class="row-date">
    <span class="row-index" aria-hidden="true">{padIndex(index)}.</span>
    <time datetime={frontmatter.publishDate}>{dateLabel}</time>
  </span>
  <span class="row-title" title={title}>{title}</span>
  {titleCategory && <span class="row-tag">{titleCategory}</span>}
  <span class="row-go">
    <span class="row-go__text">Leer</span>
    <span aria-hidden="true">→</span>
  </span>
</a>

<style>
  .article-row {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-areas: "d d t t t t t t t c c g";
    align-items: center;
    column-gap: 1rem;
    padding: 0.55rem 0.55rem;
    border-radius: 0.5rem;
    text-decoration: none;
    scroll-snap-align: start;
    transition:
      transform 0.2s var(--ease-out),
      background-color 0.2s ease;
  }

  .article-row:hover,
  .article-row:focus-visible {
    transform: translateX(4px);
    background: var(--folder-wash);
  }

  .row-date {
    grid-area: d;
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    font-family: var(--font-text);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--folder-accent);
    white-space: nowrap;
  }

  .row-index {
    opacity: 0.45;
    font-weight: 600;
  }

  .row-title {
    grid-area: t;
    min-width: 0;
    font-family: var(--font-text);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--folder-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.2s ease;
  }

  .article-row:hover .row-title,
  .article-row:focus-visible .row-title {
    color: var(--folder-accent);
  }

  .row-tag {
    grid-area: c;
    justify-self: start;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    background: var(--folder-tag);
    color: var(--folder-ink);
    font-family: var(--font-text);
    font-size: 0.58rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.15rem 0.45rem;
    border-radius: 0.3rem;
  }

  .row-go {
    grid-area: g;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    justify-self: end;
    font-family: var(--font-text);
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--folder-accent);
    white-space: nowrap;
    transition: transform 0.2s var(--ease-out);
  }

  .article-row:hover .row-go,
  .article-row:focus-visible .row-go {
    transform: translateX(2px);
  }

  .article-row:focus-visible {
    outline: 3px solid var(--folder-accent);
    outline-offset: 2px;
  }

  @media (max-width: 700px) {
    .article-row {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "d c"
        "t g";
      row-gap: 0.25rem;
    }

    .row-tag {
      justify-self: end;
    }

    .row-go__text {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .article-row,
    .row-go {
      transition: none;
    }

    .article-row:hover,
    .article-row:focus-visible {
      transform: none;
    }
  }
</style>
