---
import BlogGrid from "./BlogGrid.astro";
import { categoryConfig, getCategoryKey } from "../../data/blogCategories";
import type { CategoryConfig } from "../../data/blogCategories";
import { getAllPosts, padIndex } from "../../data/blogPosts";
import type { PostEntry } from "../../data/blogPosts";

const postsByCategory: Record<string, PostEntry[]> = {};

for (const post of getAllPosts()) {
  const categoryKey = getCategoryKey(post.frontmatter.titleCategory);
  if (!postsByCategory[categoryKey]) {
    postsByCategory[categoryKey] = [];
  }
  postsByCategory[categoryKey].push(post);
}

const folderOrder = ["idiomas", "tecnologia", "escritos"];
const orderedKeys = folderOrder.filter((key) => postsByCategory[key]?.length);
const slotNames = ["left", "center", "right"];
---

<section class="folders-stage" aria-label="Directorio de artículos por categoría">
  {orderedKeys.map((key, i) => {
    const config: CategoryConfig = categoryConfig[key] ?? {
      title: key,
      headline: key,
      theme: "black",
    };
    const posts = postsByCategory[key];
    return (
      <article class={`folder-unit folder-unit--${key} theme-${config.theme}`}>
        <input
          type="radio"
          name="blog-folder"
          id={`folder-${key}`}
          class="folder-state"
          checked={i === 0}
        />

        <div class={`folder-tab-row folder-tab-row--${slotNames[i]}`}>
          <label for={`folder-${key}`} class="folder-tab">
            <span class="tab-hit-bridge" aria-hidden="true"></span>
            <span class="tab-dot" aria-hidden="true"></span>
            <span class="folder-tab__label">
              {padIndex(i + 1)} // {config.title}
            </span>
            <span class="folder-tab__count" aria-hidden="true">
              [{padIndex(posts.length)}]
            </span>
          </label>
        </div>

        <div class="folder-body">
          <header class="folder-content-layer folder-header">
            <span class="folder-index-badge" aria-hidden="true">
              {padIndex(i + 1)}
            </span>
            <div class="folder-header__text">
              <p class="folder-kicker">
                <span>Expediente {padIndex(i + 1)} // {posts.length} artículos</span>
                <span class="folder-chip">Activo</span>
              </p>
              <h2 class="folder-title">{config.headline}</h2>
            </div>
          </header>

          <div class="folder-content-layer folder-viewport">
            <BlogGrid
              posts={posts}
              label={`Últimos artículos de ${config.title}`}
            />
          </div>

          <footer class="folder-content-layer folder-footer">
            <span class="folder-scroll-hint">
              ↕ Desliza ({padIndex(1)}–{padIndex(posts.length)})
            </span>
            <span class="folder-scroll-hint">{config.title}</span>
          </footer>
        </div>
      </article>
    );
  })}
</section>

<style>
  .folders-stage {
    --tab-h: 2.25rem;
    --tab-inset: 1.75rem;
    --stage-h: 375px;
    --fillet: 12px;
    --folder-lift: translateY(-11px);
    position: relative;
    width: var(--width-container);
    max-width: var(--page-max-width);
    height: var(--stage-h);
    padding: var(--page-pad-y) var(--page-pad-x);
    margin: var(--page-margin);
  }

  .folder-state {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .theme-white {
    --folder-bg: var(--color-white);
    --folder-ink: var(--color-ink);
    --folder-accent: var(--color-orange);
    --folder-muted: var(--color-stone);
    --folder-edge-highlight: rgb(255 255 255 / 0.95);
    --scroll-thumb: color-mix(in srgb, var(--color-orange) 35%, transparent);
    --scroll-track: color-mix(in srgb, var(--color-orange) 8%, transparent);
  }

  .theme-orange {
    --folder-bg: var(--color-orange);
    --folder-ink: var(--color-ink);
    --folder-accent: var(--color-ink);
    --folder-muted: color-mix(in srgb, var(--color-ink) 72%, transparent);
    --folder-edge-highlight: rgb(255 255 255 / 0.28);
    --scroll-thumb: color-mix(in srgb, var(--color-ink) 45%, transparent);
    --scroll-track: color-mix(in srgb, var(--color-ink) 12%, transparent);
  }

  .theme-black {
    --folder-bg: var(--color-ink);
    --folder-ink: var(--color-cream);
    --folder-accent: var(--color-orange);
    --folder-muted: var(--color-stone);
    --folder-edge-highlight: rgb(255 255 255 / 0.12);
    --scroll-thumb: color-mix(in srgb, var(--color-orange) 55%, transparent);
    --scroll-track: rgb(255 255 255 / 0.08);
  }

  .folder-unit {
    --folder-rule: color-mix(in srgb, var(--folder-ink) 16%, transparent);
    --folder-wash: color-mix(in srgb, var(--folder-ink) 7%, transparent);
    --folder-tag: color-mix(in srgb, var(--folder-ink) 12%, transparent);
    --fillet-stops: transparent var(--fillet), var(--folder-bg) calc(var(--fillet) + 0.5px);
    position: absolute;
    inset: var(--page-pad-y) var(--page-pad-x);
    display: flex;
    flex-direction: column;
    z-index: 10;
    pointer-events: none;
    filter: drop-shadow(0 -3px 10px color-mix(in srgb, var(--color-ink) 8%, transparent));
    transition:
      transform 0.42s var(--ease-out),
      filter 0.42s var(--ease-out);
  }

  .folder-unit:has(> .folder-state:checked) {
    z-index: 30;
    filter: drop-shadow(0 18px 34px color-mix(in srgb, var(--color-ink) 14%, transparent));
  }

  .folder-unit:not(:has(> .folder-state:checked)):has(.folder-tab:hover) {
    transform: var(--folder-lift);
  }

  .folder-unit:has(> .folder-state:checked) .folder-body {
    pointer-events: auto;
  }

  .folder-unit:has(> .folder-state:checked) .folder-content-layer {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .folder-unit:has(> .folder-state:checked) .tab-dot {
    transform: scale(1.15);
  }

  .folder-unit:has(> .folder-state:focus-visible) .folder-tab {
    outline: 3px solid var(--color-primary);
    outline-offset: 4px;
  }

  .folder-content-layer {
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition:
      opacity 0.32s ease,
      transform 0.36s var(--ease-out),
      visibility 0.32s;
  }

  .folder-tab-row {
    display: flex;
    width: 100%;
    height: var(--tab-h);
    flex-shrink: 0;
    position: relative;
    z-index: 2;
    margin-bottom: -1px;
  }

  .folder-tab-row--left {
    justify-content: flex-start;
    padding-left: var(--tab-inset);
  }

  .folder-tab-row--center {
    justify-content: center;
  }

  .folder-tab-row--right {
    justify-content: flex-end;
    padding-right: var(--tab-inset);
  }

  .folder-tab {
    position: relative;
    pointer-events: auto;
    height: var(--tab-h);
    padding: 0 1.5rem;
    border-radius: 0.75rem 0.75rem 0 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--folder-bg);
    color: var(--folder-accent);
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
    box-shadow: inset 0 1px 0 var(--folder-edge-highlight);
    font-family: var(--font-title);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .folder-tab::before,
  .folder-tab::after {
    content: "";
    position: absolute;
    bottom: 0;
    width: var(--fillet);
    height: var(--fillet);
    pointer-events: none;
  }

  .folder-tab::before {
    left: calc(var(--fillet) * -1);
    background: radial-gradient(circle at 0 0, var(--fillet-stops));
  }

  .folder-tab::after {
    right: calc(var(--fillet) * -1);
    background: radial-gradient(circle at 100% 0, var(--fillet-stops));
  }

  .tab-hit-bridge {
    position: absolute;
    pointer-events: auto;
    left: -0.375rem;
    right: -0.375rem;
    bottom: -1.125rem;
    height: 1.375rem;
    background: transparent;
  }

  .tab-dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 999px;
    background: var(--folder-accent);
    transition: transform 0.3s ease;
  }

  .folder-tab__count {
    font-size: 0.58rem;
    font-weight: 600;
    opacity: 0.6;
    margin-left: 0.15rem;
  }

  .folder-body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    background: var(--folder-bg);
    color: var(--folder-ink);
    border-radius: 1.125rem;
    padding: 1.375rem 1.75rem;
    position: relative;
    z-index: 1;
    overflow: hidden;
    box-shadow: inset 0 1px 0 var(--folder-edge-highlight);
  }

  .folder-header {
    display: flex;
    align-items: flex-start;
    gap: 1.1rem;
    border-bottom: 1px solid var(--folder-rule);
    padding-bottom: 0.85rem;
  }

  .folder-index-badge {
    font-family: var(--font-title);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    padding-right: 0.75rem;
    border-right: 1px solid currentColor;
    color: var(--folder-accent);
    opacity: 0.85;
    user-select: none;
    flex-shrink: 0;
  }

  .folder-header__text {
    min-width: 0;
  }

  .folder-kicker {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-text);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--folder-muted);
    margin: 0;
  }

  .folder-chip {
    background: color-mix(in srgb, var(--folder-accent) 12%, transparent);
    color: var(--folder-accent);
    border: 1px solid color-mix(in srgb, var(--folder-accent) 25%, transparent);
    padding: 0.05rem 0.45rem;
    border-radius: 0.375rem;
    font-size: 0.55rem;
  }

  .folder-title {
    font-family: var(--font-title);
    font-size: var(--fs-h3);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    line-height: var(--leading-tight);
    color: var(--folder-ink);
    margin: 0.3rem 0 0;
  }

  .folder-viewport {
    flex: 1;
    min-height: 0;
    display: flex;
  }

  .folder-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    border-top: 1px solid var(--folder-rule);
    padding-top: 0.85rem;
  }

  .folder-scroll-hint {
    font-family: var(--font-text);
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--folder-muted);
    min-width: 0;
    overflow-wrap: anywhere;
  }

  @media (max-width: 767px) {
    .folders-stage {
      --stage-h: 430px;
      --folder-lift: translateX(6px);
    }

    .folder-unit {
      flex-direction: row-reverse;
    }

    .folder-tab-row {
      width: 2.375rem;
      height: 100%;
      flex-direction: column;
      margin-bottom: 0;
      margin-left: -1px;
      padding: 0;
    }

    .folder-tab-row--left {
      justify-content: flex-start;
      padding-top: 1.375rem;
    }

    .folder-tab-row--right {
      justify-content: flex-end;
      padding-bottom: 1.375rem;
    }

    .folder-tab {
      width: 2.375rem;
      height: auto;
      min-height: 7rem;
      padding: 0.875rem 0;
      border-radius: 0 0.75rem 0.75rem 0;
      writing-mode: vertical-rl;
      text-orientation: mixed;
      justify-content: center;
      box-shadow: inset -1px 0 0 var(--folder-edge-highlight);
    }

    .tab-hit-bridge {
      top: -0.375rem;
      bottom: -0.375rem;
      left: -1.125rem;
      right: auto;
      width: 1.375rem;
      height: auto;
    }

    .folder-tab::before {
      top: calc(var(--fillet) * -1);
      bottom: auto;
      left: calc(var(--fillet) * -1);
      right: auto;
    }

    .folder-tab::after {
      bottom: calc(var(--fillet) * -1);
      top: auto;
      left: calc(var(--fillet) * -1);
      right: auto;
      background: radial-gradient(circle at 0 100%, var(--fillet-stops));
    }

    .folder-body {
      padding: 1rem;
      border-radius: 1rem;
      gap: 0.75rem;
    }

    .folder-index-badge {
      font-size: 1.375rem;
      padding-right: 0.575rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .folder-unit,
    .folder-content-layer,
    .tab-dot {
      transition: none;
    }
  }
</style>

<script>
  const folder = window.location.hash.slice(1);
  const target = document.getElementById(`folder-${folder}`);
  if (target instanceof HTMLInputElement) {
    target.checked = true;
  }
</script>
