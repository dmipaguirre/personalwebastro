---
import ArticleCard from "./ArticleCard.astro";
import type { PostEntry } from "../../data/blogPosts";

interface Props {
  posts: PostEntry[];
  label?: string;
}

const { posts, label = "Últimos artículos" } = Astro.props;
---

<div class="folder-viewer">
  <div class="folder-viewer__scroll" tabindex="0" role="group" aria-label={label}>
    {posts.map((post, i) => (
      <ArticleCard post={post} index={i + 1} />
    ))}
  </div>
</div>

<style>
  .folder-viewer {
    flex: 1;
    min-width: 0;
    min-height: 0;
    display: flex;
  }

  .folder-viewer__scroll {
    --fade-edge: linear-gradient(
      to bottom,
      transparent 0,
      #000 1.15rem,
      #000 calc(100% - 1.25rem),
      transparent 100%
    );
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scroll-behavior: smooth;
    scroll-snap-type: y proximity;
    scroll-padding-block: 0.35rem;
    scrollbar-width: thin;
    scrollbar-color: var(--scroll-thumb) var(--scroll-track);
    padding: 0.55rem 0.35rem 0.85rem;
    -webkit-mask-image: var(--fade-edge);
    mask-image: var(--fade-edge);
  }

  .folder-viewer__scroll::-webkit-scrollbar {
    width: 4px;
  }

  .folder-viewer__scroll::-webkit-scrollbar-track {
    background: var(--scroll-track);
    border-radius: 99px;
  }

  .folder-viewer__scroll::-webkit-scrollbar-thumb {
    background: var(--scroll-thumb);
    border-radius: 99px;
  }

  .folder-viewer__scroll:focus-visible {
    outline: 3px solid var(--folder-accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .folder-viewer__scroll {
      scroll-behavior: auto;
    }
  }
</style>
